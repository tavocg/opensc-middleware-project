diff --git a/src/libopensc/jcop4-channel-agreement.h b/src/libopensc/jcop4-channel-agreement.h
new file mode 100644
index 0000000000000000000000000000000000000000..0b018c4d3e6802630c7af9373a9d89090657a322
--- /dev/null
+++ b/src/libopensc/jcop4-channel-agreement.h
@@ -0,0 +1,194 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Offline candidate anonymous CA/P-521/AES128 preparation.
+ * Does not establish/authenticate a channel, send APDU or handle a PIN.
+ * Outputs are pending until setup AND a protected response are verified. */
+#ifndef JCOP4_CHANNEL_AGREEMENT_H
+#define JCOP4_CHANNEL_AGREEMENT_H
+
+#include "jcop4-channel-kdf.h"
+#include <openssl/bn.h>
+#include <openssl/core_names.h>
+#include <openssl/ec.h>
+#include <openssl/obj_mac.h>
+#include <openssl/params.h>
+
+#define JCOP4_P521_POINT_SIZE 133
+struct jcop4_ca_pending {
+	unsigned char terminal_public[JCOP4_P521_POINT_SIZE];
+	struct jcop4_channel_keys keys;
+};
+
+static inline void
+jcop4_ca_pending_clear(struct jcop4_ca_pending *pending)
+{
+	if (pending)
+		OPENSSL_cleanse(pending, sizeof(*pending));
+}
+
+/* Only canonical uncompressed SEC1 P-521 points. Mathematical validation,
+ * not proof of card identity, provenance or permission to authenticate. */
+static inline int
+jcop4_p521_public_valid(const unsigned char *encoded, size_t size)
+{
+	EC_GROUP *group = NULL;
+	EC_POINT *point = NULL;
+	BIGNUM *x = NULL, *y = NULL, *prime = NULL;
+	int valid = 0;
+	if (!encoded || size != JCOP4_P521_POINT_SIZE || encoded[0] != 4)
+		return 0;
+	group = EC_GROUP_new_by_curve_name(NID_secp521r1);
+	if (group)
+		point = EC_POINT_new(group);
+	x = BN_bin2bn(encoded + 1, 66, NULL);
+	y = BN_bin2bn(encoded + 67, 66, NULL);
+	prime = BN_new();
+	if (group && point && x && y && prime && EC_GROUP_get_curve(group, prime, NULL, NULL, NULL) == 1 &&
+			BN_cmp(x, prime) < 0 && BN_cmp(y, prime) < 0 &&
+			EC_POINT_set_affine_coordinates(group, point, x, y, NULL) == 1 &&
+			EC_POINT_is_at_infinity(group, point) == 0 && EC_POINT_is_on_curve(group, point, NULL) == 1)
+		valid = 1;
+	BN_clear_free(x);
+	BN_clear_free(y);
+	BN_clear_free(prime);
+	EC_POINT_clear_free(point);
+	EC_GROUP_free(group);
+	return valid;
+}
+
+/* Common implementation. The production entry point below generates the
+ * ephemeral key internally; tests inject public deterministic fixtures here.
+ * Caller retains ownership of local_key. No private scalar is exported. */
+static inline int
+jcop4_ca_prepare_key_ex(OSSL_LIB_CTX *libctx, EVP_PKEY *local_key, const unsigned char *peer,
+		size_t peer_size, struct jcop4_ca_pending *pending)
+{
+	struct jcop4_ca_pending candidate = {
+			{0},
+			{{0}, {0}, {0}}
+	       };
+	EVP_PKEY_CTX *import = NULL, *check = NULL, *derive = NULL;
+	EVP_PKEY *peer_key = NULL;
+	unsigned char secret[66] = {0};
+	char name[80] = {0}, group_name[] = "secp521r1", no_kdf[] = "";
+	size_t name_size = 0, public_size = 0, secret_size = sizeof(secret);
+	int cofactor = 0, result = 1;
+	unsigned int pad = 1;
+	OSSL_PARAM public_params[3], derive_params[4];
+	if (!pending)
+		return 1;
+	if (!local_key || !jcop4_p521_public_valid(peer, peer_size) || EVP_PKEY_is_a(local_key, "EC") != 1 ||
+			EVP_PKEY_get_utf8_string_param(local_key, OSSL_PKEY_PARAM_GROUP_NAME, name, sizeof(name), &name_size) != 1 ||
+			(strcmp(name, "secp521r1") && strcmp(name, "P-521")))
+		goto out;
+	check = EVP_PKEY_CTX_new_from_pkey(libctx, local_key, NULL);
+	if (!check || EVP_PKEY_param_check(check) != 1 || EVP_PKEY_private_check(check) != 1 ||
+			EVP_PKEY_pairwise_check(check) != 1 ||
+			EVP_PKEY_get_octet_string_param(local_key, OSSL_PKEY_PARAM_ENCODED_PUBLIC_KEY,
+					candidate.terminal_public, sizeof(candidate.terminal_public), &public_size) != 1 ||
+			!jcop4_p521_public_valid(candidate.terminal_public, public_size))
+		goto out;
+	public_params[0] = OSSL_PARAM_construct_utf8_string(OSSL_PKEY_PARAM_GROUP_NAME, group_name, 0);
+	public_params[1] = OSSL_PARAM_construct_octet_string(OSSL_PKEY_PARAM_PUB_KEY, (void *)peer, peer_size);
+	public_params[2] = OSSL_PARAM_construct_end();
+	import = EVP_PKEY_CTX_new_from_name(libctx, "EC", NULL);
+	if (!import || EVP_PKEY_fromdata_init(import) != 1 ||
+			EVP_PKEY_fromdata(import, &peer_key, EVP_PKEY_PUBLIC_KEY, public_params) != 1)
+		goto out;
+	EVP_PKEY_CTX_free(check);
+	check = EVP_PKEY_CTX_new_from_pkey(libctx, peer_key, NULL);
+	if (!check || EVP_PKEY_public_check(check) != 1)
+		goto out;
+	derive = EVP_PKEY_CTX_new_from_pkey(libctx, local_key, NULL);
+	derive_params[0] = OSSL_PARAM_construct_utf8_string(OSSL_EXCHANGE_PARAM_KDF_TYPE, no_kdf, 0);
+	derive_params[1] = OSSL_PARAM_construct_int(OSSL_EXCHANGE_PARAM_EC_ECDH_COFACTOR_MODE, &cofactor);
+	derive_params[2] = OSSL_PARAM_construct_uint(OSSL_EXCHANGE_PARAM_PAD, &pad);
+	derive_params[3] = OSSL_PARAM_construct_end();
+	if (!derive || EVP_PKEY_derive_init_ex(derive, derive_params) != 1 ||
+			EVP_PKEY_derive_set_peer(derive, peer_key) != 1 ||
+			EVP_PKEY_derive(derive, secret, &secret_size) != 1 || secret_size != sizeof(secret) ||
+			jcop4_ca_aes128_kdf_ex(libctx, secret, secret_size, &candidate.keys))
+		goto out;
+	memcpy(pending, &candidate, sizeof(candidate));
+	result = 0;
+out:
+	if (result)
+		jcop4_ca_pending_clear(pending);
+	jcop4_ca_pending_clear(&candidate);
+	OPENSSL_cleanse(secret, sizeof(secret));
+	EVP_PKEY_CTX_free(import);
+	EVP_PKEY_CTX_free(check);
+	EVP_PKEY_CTX_free(derive);
+	EVP_PKEY_free(peer_key);
+	return result;
+}
+
+/* Context/provider policy applies to key generation, validation, import,
+ * ECDH and KDF. No provider loading, property override or global fallback. */
+static inline int
+jcop4_ca_prepare_ex(OSSL_LIB_CTX *libctx, const unsigned char *peer,
+		size_t peer_size, struct jcop4_ca_pending *pending)
+{
+	EVP_PKEY *ephemeral = NULL;
+	EVP_PKEY_CTX *keygen = NULL;
+	int result = 1;
+	char group[] = "secp521r1";
+	OSSL_PARAM params[] = {
+			OSSL_PARAM_construct_utf8_string(OSSL_PKEY_PARAM_GROUP_NAME, group, 0),
+			OSSL_PARAM_construct_end()};
+	if (!pending)
+		return 1;
+	if (jcop4_p521_public_valid(peer, peer_size)) {
+		keygen = EVP_PKEY_CTX_new_from_name(libctx, "EC", NULL);
+		if (keygen && EVP_PKEY_keygen_init(keygen) == 1 &&
+				EVP_PKEY_CTX_set_params(keygen, params) == 1 && EVP_PKEY_generate(keygen, &ephemeral) == 1)
+			result = jcop4_ca_prepare_key_ex(libctx, ephemeral, peer, peer_size, pending);
+	}
+	EVP_PKEY_CTX_free(keygen);
+	EVP_PKEY_free(ephemeral);
+	if (result)
+		jcop4_ca_pending_clear(pending);
+	return result;
+}
+
+/* Canonical wire bytes shared by the transport validator so the accepted
+ * commands cannot drift from the constructed ones. */
+#define JCOP4_CA_MSE_BYTES {0x00, 0x22, 0x41, 0xA4, 0x0C, 0x80, 0x0A, 0x04, 0x00, 0x7F, 0x00, 0x07, 0x02, 0x02, 0x03, 0x02, 0x02}
+#define JCOP4_CA_GA_PREFIX_BYTES {0x10, 0x86, 0x00, 0x00, 0x8B, 0x7C, 0x81, 0x88, 0x80, 0x81, 0x85}
+
+/* Candidate wire bytes for the reviewed plain transport path, not a sender.
+ * MSE/GA constructor Le=0 (absent), serializer copies CLA unchanged. Other
+ * runtime pipes/profiles remain unproven: never use as channel confirmation. */
+static inline int
+jcop4_ca_build_mse(unsigned char *out, size_t capacity, size_t *written)
+{
+	static const unsigned char candidate[] = JCOP4_CA_MSE_BYTES;
+	if (!written)
+		return 1;
+	*written = 0;
+	if (!out || capacity < sizeof(candidate))
+		return 1;
+	memcpy(out, candidate, sizeof(candidate));
+	*written = sizeof(candidate);
+	return 0;
+}
+
+static inline int
+jcop4_ca_build_ga(const unsigned char *terminal_public, size_t size,
+		unsigned char *out, size_t capacity, size_t *written)
+{
+	/* Lc139, 7C length136, 80 length133, SEC1 prefix04; no trailing Le. */
+	static const unsigned char prefix[] = JCOP4_CA_GA_PREFIX_BYTES;
+	unsigned char candidate[sizeof(prefix) + JCOP4_P521_POINT_SIZE];
+	if (!written)
+		return 1;
+	*written = 0;
+	if (!out || capacity < sizeof(candidate) || !jcop4_p521_public_valid(terminal_public, size))
+		return 1;
+	memcpy(candidate, prefix, sizeof(prefix));
+	memcpy(candidate + sizeof(prefix), terminal_public, size);
+	memcpy(out, candidate, sizeof(candidate));
+	*written = sizeof(candidate);
+	return 0;
+}
+
+#endif
diff --git a/src/libopensc/jcop4-channel-confirmation.h b/src/libopensc/jcop4-channel-confirmation.h
new file mode 100644
index 0000000000000000000000000000000000000000..63e4baeb8dd64aa07cd30b33a6c0066c4e327b14
--- /dev/null
+++ b/src/libopensc/jcop4-channel-confirmation.h
@@ -0,0 +1,179 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Candidate no-PIN confirmation sequence, transport supplied by the caller.
+ * No PC/SC, reader discovery, Idopte or credential API in this component.
+ * Caller must have selected the known ADF/D004 and validated its control and
+ * initial137-byte read in the same exclusively owned connection. */
+#ifndef JCOP4_CHANNEL_CONFIRMATION_H
+#define JCOP4_CHANNEL_CONFIRMATION_H
+
+#include "jcop4-channel-agreement.h"
+#include "jcop4-channel-messages.h"
+
+enum jcop4_ca_probe_stage { JCOP4_CA_INPUT,
+	JCOP4_CA_PREPARE,
+	JCOP4_CA_MSE,
+	JCOP4_CA_GA,
+	JCOP4_CA_READ };
+enum jcop4_ca_probe_outcome {
+	JCOP4_CA_INVALID_INPUT,
+	JCOP4_CA_CRYPTO_FAILED,
+	JCOP4_CA_TRANSPORT_FAILED,
+	JCOP4_CA_RESPONSE_SHAPE_FAILED,
+	JCOP4_CA_SETUP_SW_FAILED,
+	JCOP4_CA_PROTECTED_RESPONSE_FAILED,
+	JCOP4_CA_INNER_SW_FAILED,
+	JCOP4_CA_CONTENT_MISMATCH,
+	JCOP4_CA_READ_CONFIRMED
+};
+/* Two static branches for this fixed137-byte READ/MAC8, not a fallback list.
+ * A hardware caller must justify its policy before setup, never try both. */
+enum jcop4_ca_outer_le { JCOP4_CA_LE_BOUND = 172,
+	JCOP4_CA_LE_SHORT_MAX = 256 };
+struct jcop4_ca_probe_report {
+	enum jcop4_ca_probe_stage stage;
+	enum jcop4_ca_probe_outcome outcome;
+	int transport;
+	unsigned int sw;
+	int authenticated_response;
+	size_t content_size;
+	int content_size_equal, content_first_block_equal, content_tail_equal;
+};
+typedef int (*jcop4_ca_exchange)(void *context, const unsigned char *command, size_t command_size,
+		unsigned char *response, size_t capacity, size_t *received);
+
+/* Return0 means exactly one protected READ matched the initial data, not a
+ * logged-in token, trusted identity or signing capability.
+ * Optional confirmed must be initialized INVALID before entry. An active
+ * destination is refused before I/O and preserved so its owner can close it.
+ * Only after full confirmation does it receive IDLE state and SSC2. It belongs
+ * to this same exclusively owned connection; no reset/reconnect/other client
+ * or plaintext operation may be inserted before continuing. The owner must
+ * wipe it AND end/reset the remote session on every exit/transport failure.
+ * This crypto-only component cannot itself enforce the connection identity.
+ * Without confirmed, this operation remains a probe and always wipes state.
+ * Callback returns0 for success, receives capacity258 (including physicalSW).
+ * No retries, GET RESPONSE, PIN status, VERIFY or post-probe commands. */
+static inline int
+jcop4_ca_confirm_d004_session_ex(OSSL_LIB_CTX *libctx, const unsigned char *initial, size_t initial_size,
+		enum jcop4_ca_outer_le outer_le, jcop4_ca_exchange exchange, void *context,
+		struct jcop4_ca_probe_report *report, struct jcop4_sm_channel *confirmed)
+{
+	struct jcop4_ca_pending pending = {
+			{0},
+			{{0}, {0}, {0}}
+	       };
+	struct jcop4_sm_channel channel = {
+			{{0}, {0}, {0}},
+			JCOP4_SM_INVALID
+	};
+	unsigned char peer[133] = {0}, command[144] = {0}, response[258] = {0};
+	unsigned char header[4] = {0}, body[64] = {0}, plain[137] = {0};
+	const unsigned char read_header[4] = {0, 0xB0, 0, 0};
+	size_t command_size = 0, received = 0, body_size = 0, plain_size = 0;
+	unsigned int inner_sw = 0;
+	int result = 1;
+	if (!report) {
+		if (confirmed && confirmed->phase == JCOP4_SM_INVALID)
+			jcop4_sm_invalidate(confirmed);
+		return 1;
+	}
+	memset(report, 0, sizeof(*report));
+	if (confirmed && confirmed->phase != JCOP4_SM_INVALID)
+		return 1;
+	if (confirmed)
+		jcop4_sm_invalidate(confirmed);
+	if (!initial || initial_size != 137 || initial[2] != 18 || !exchange ||
+			(outer_le != JCOP4_CA_LE_BOUND && outer_le != JCOP4_CA_LE_SHORT_MAX))
+		goto out;
+	peer[0] = 4;
+	memcpy(peer + 1, initial + 5, 132);
+	if (!jcop4_p521_public_valid(peer, sizeof(peer)))
+		goto out;
+	report->stage = JCOP4_CA_PREPARE;
+	report->outcome = JCOP4_CA_CRYPTO_FAILED;
+	if (jcop4_ca_prepare_ex(libctx, peer, sizeof(peer), &pending) ||
+			jcop4_ca_build_mse(command, sizeof(command), &command_size))
+		goto out;
+	for (int step = 0; step < 2; step++) {
+		report->stage = step ? JCOP4_CA_GA : JCOP4_CA_MSE;
+		report->sw = 0;
+		report->outcome = JCOP4_CA_TRANSPORT_FAILED;
+		received = 0;
+		memset(response, 0, sizeof(response));
+		report->transport = exchange(context, command, command_size, response, sizeof(response), &received);
+		if (report->transport)
+			goto out;
+		report->outcome = JCOP4_CA_RESPONSE_SHAPE_FAILED;
+		if (received < 2 || received > sizeof(response))
+			goto out;
+		report->sw = (unsigned int)response[received - 2] * 256 + response[received - 1];
+		report->outcome = JCOP4_CA_SETUP_SW_FAILED;
+		if (report->sw != 0x9000)
+			goto out;
+		report->outcome = JCOP4_CA_RESPONSE_SHAPE_FAILED;
+		/* Empty GA template is accepted, but nonce/token or any other payload
+		 * stops this candidate. Never silently discard authentication data. */
+		if (received != 2 && !(step && received == 4 && response[0] == 0x7C && response[1] == 0))
+			goto out;
+		if (!step) {
+			report->stage = JCOP4_CA_PREPARE;
+			report->outcome = JCOP4_CA_CRYPTO_FAILED;
+			if (jcop4_ca_build_ga(pending.terminal_public, sizeof(pending.terminal_public),
+					    command, sizeof(command), &command_size))
+				goto out;
+		}
+	}
+	report->stage = JCOP4_CA_PREPARE;
+	report->outcome = JCOP4_CA_CRYPTO_FAILED;
+	report->sw = 0;
+	if (jcop4_sm_init(&channel, &pending.keys) ||
+			jcop4_sm_seal_policy_ex(libctx, &channel, read_header, NULL, 0, 1, 137, header, body, sizeof(body), &body_size, JCOP4_SM_LE_SHORT) ||
+			body_size != 13)
+		goto out;
+	memcpy(command, header, 4);
+	command[4] = (unsigned char)body_size;
+	memcpy(command + 5, body, body_size);
+	command[5 + body_size] = (unsigned char)outer_le;
+	command_size = 6 + body_size; /* Case4 short; 256 serializes as00. */
+	report->stage = JCOP4_CA_READ;
+	report->outcome = JCOP4_CA_TRANSPORT_FAILED;
+	received = 0;
+	memset(response, 0, sizeof(response));
+	report->transport = exchange(context, command, command_size, response, sizeof(response), &received);
+	if (report->transport)
+		goto out;
+	report->outcome = JCOP4_CA_PROTECTED_RESPONSE_FAILED;
+	if (received > sizeof(response) || jcop4_sm_open_report_policy_ex(libctx, &channel, response, received, plain, sizeof(plain), &plain_size, &inner_sw, JCOP4_SM_OUTER_9000))
+		goto out;
+	report->authenticated_response = 1;
+	report->sw = inner_sw;
+	report->outcome = JCOP4_CA_INNER_SW_FAILED;
+	if (inner_sw != 0x9000)
+		goto out;
+	/* Fixed D004 comparisons only after MAC/padding and inner SW pass.
+	 * No raw bytes, hashes, differing offsets or acceptance of partial data. */
+	report->content_size = plain_size;
+	report->content_size_equal = plain_size == initial_size;
+	if (report->content_size_equal) {
+		report->content_first_block_equal = !CRYPTO_memcmp(plain, initial, 16);
+		report->content_tail_equal = !CRYPTO_memcmp(plain + 16, initial + 16, initial_size - 16);
+	}
+	report->outcome = JCOP4_CA_CONTENT_MISMATCH;
+	if (plain_size != initial_size || CRYPTO_memcmp(plain, initial, initial_size))
+		goto out;
+	report->outcome = JCOP4_CA_READ_CONFIRMED;
+	if (confirmed)
+		memcpy(confirmed, &channel, sizeof(*confirmed));
+	result = 0;
+out:
+	jcop4_ca_pending_clear(&pending);
+	jcop4_sm_invalidate(&channel);
+	OPENSSL_cleanse(peer, sizeof(peer));
+	OPENSSL_cleanse(command, sizeof(command));
+	OPENSSL_cleanse(response, sizeof(response));
+	OPENSSL_cleanse(body, sizeof(body));
+	OPENSSL_cleanse(plain, sizeof(plain));
+	return result;
+}
+
+#endif
diff --git a/src/libopensc/jcop4-channel-controls.h b/src/libopensc/jcop4-channel-controls.h
new file mode 100644
index 0000000000000000000000000000000000000000..d7e58927b50562355f9e911088fbdffae7f5d351
--- /dev/null
+++ b/src/libopensc/jcop4-channel-controls.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef JCOP4_CHANNEL_CONTROLS_H
+#define JCOP4_CHANNEL_CONTROLS_H
+#include "jcop4-channel-messages.h"
+/* Validate only MF identity/DF structure, never emit its raw control data. */
+static inline int
+jcop4_sm_mf_control(const unsigned char *data, size_t size)
+{
+	const unsigned char *value;
+	size_t offset = 0, length;
+	int fid = 0, descriptor = 0;
+	if (!data || !size || size > 256)
+		return 1;
+	/* Canonical FCP62 or FCI6F; the latter can wrap exactly one FCP62. */
+	unsigned char outer = data[0];
+	if (outer != 0x62 && outer != 0x6F)
+		return 1;
+	if (jcop4_sm_take_tlv(data, size, &offset, outer, &value, &length) || offset != size)
+		return 1;
+	data = value;
+	size = length;
+	offset = 0;
+	if (outer == 0x6F && size && data[0] == 0x62) {
+		if (jcop4_sm_take_tlv(data, size, &offset, 0x62, &value, &length) || offset != size)
+			return 1;
+		data = value;
+		size = length;
+		offset = 0;
+	}
+	while (offset < size) {
+		unsigned char tag = data[offset];
+		if ((tag & 31) == 31 || jcop4_sm_take_tlv(data, size, &offset, tag, &value, &length))
+			return 1;
+		if (tag == 0x83 && (fid++ || length != 2 || value[0] != 0x3F || value[1]))
+			return 1;
+		if (tag == 0x82 && (descriptor++ || !length || length > 6 || (value[0] & 0x80) || (value[0] & 0x3F) != 0x38))
+			return 1;
+	}
+	return fid != 1 || descriptor != 1;
+}
+#endif
diff --git a/src/libopensc/jcop4-channel-kdf.h b/src/libopensc/jcop4-channel-kdf.h
new file mode 100644
index 0000000000000000000000000000000000000000..698f60c09c21180048d9f051a42c1f4c2159f0dc
--- /dev/null
+++ b/src/libopensc/jcop4-channel-kdf.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Offline candidate for the reviewed anonymous CA/AES128 branch.
+ * No card I/O, key agreement, PIN handling or secure messaging here. */
+#ifndef JCOP4_CHANNEL_KDF_H
+#define JCOP4_CHANNEL_KDF_H
+
+#include <openssl/crypto.h>
+#include <openssl/evp.h>
+#include <stddef.h>
+#include <string.h>
+
+struct jcop4_channel_keys {
+	unsigned char encryption[16];
+	unsigned char mac[16];
+	unsigned char ssc[16];
+};
+
+static inline int
+jcop4_ca_aes128_kdf_ex(OSSL_LIB_CTX *libctx, const unsigned char *shared_secret, size_t secret_size,
+		struct jcop4_channel_keys *keys)
+{
+	struct jcop4_channel_keys candidate = {{0}, {0}, {0}};
+	EVP_MD *md = NULL;
+	EVP_MD_CTX *ctx = NULL;
+	unsigned char digest[EVP_MAX_MD_SIZE] = {0};
+	unsigned int digest_size = 0;
+	int counter, result = 1;
+	if (!keys)
+		return 1;
+	if (!shared_secret || secret_size != 66)
+		goto out;
+	md = EVP_MD_fetch(libctx, "SHA1", NULL);
+	ctx = EVP_MD_CTX_new();
+	if (!md || !ctx)
+		goto out;
+	for (counter = 1; counter <= 2; counter++) {
+		const unsigned char encoded_counter[4] = {0, 0, 0, (unsigned char)counter};
+		if (EVP_DigestInit_ex2(ctx, md, NULL) != 1 ||
+				EVP_DigestUpdate(ctx, shared_secret, secret_size) != 1 ||
+				EVP_DigestUpdate(ctx, encoded_counter, sizeof(encoded_counter)) != 1 ||
+				EVP_DigestFinal_ex(ctx, digest, &digest_size) != 1 || digest_size != 20)
+			goto out;
+		memcpy(counter == 1 ? candidate.encryption : candidate.mac, digest, 16);
+		OPENSSL_cleanse(digest, sizeof(digest));
+	}
+	/* Commit both keys together; never expose a partially derived output.
+	 * The zero SSC is part of this candidate, not an observed card session. */
+	memcpy(keys, &candidate, sizeof(candidate));
+	result = 0;
+out:
+	if (result)
+		OPENSSL_cleanse(keys, sizeof(*keys));
+	OPENSSL_cleanse(&candidate, sizeof(candidate));
+	OPENSSL_cleanse(digest, sizeof(digest));
+	EVP_MD_CTX_free(ctx);
+	EVP_MD_free(md);
+	return result;
+}
+
+#endif
diff --git a/src/libopensc/jcop4-channel-messages.h b/src/libopensc/jcop4-channel-messages.h
new file mode 100644
index 0000000000000000000000000000000000000000..93d13d4ce929af744438ae660cdd83a46aa3bab9
--- /dev/null
+++ b/src/libopensc/jcop4-channel-messages.h
@@ -0,0 +1,279 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Candidate codec for the reviewed AES128/IV=AES(Kenc,SSC)/MAC8 branch.
+ * Does not serialize transport Lc/Le, perform card I/O or establish a channel.
+ * Initialize only with fresh session keys after a separately verified setup. */
+#ifndef JCOP4_CHANNEL_MESSAGES_H
+#define JCOP4_CHANNEL_MESSAGES_H
+
+#include "jcop4-channel-kdf.h"
+#include "jcop4-channel-primitives.h"
+
+#define JCOP4_SM_DATA_LIMIT 3584
+enum jcop4_sm_phase { JCOP4_SM_INVALID,
+	JCOP4_SM_IDLE,
+	JCOP4_SM_WAITING };
+struct jcop4_sm_channel {
+	struct jcop4_channel_keys keys;
+	enum jcop4_sm_phase phase;
+};
+
+static inline void
+jcop4_sm_invalidate(struct jcop4_sm_channel *channel)
+{
+	if (channel) {
+		OPENSSL_cleanse(channel, sizeof(*channel));
+		channel->phase = JCOP4_SM_INVALID;
+	}
+}
+
+static inline int
+jcop4_sm_init(struct jcop4_sm_channel *channel, const struct jcop4_channel_keys *keys)
+{
+	if (!channel)
+		return 1;
+	if (!keys) {
+		jcop4_sm_invalidate(channel);
+		return 1;
+	}
+	memcpy(&channel->keys, keys, sizeof(*keys));
+	channel->phase = JCOP4_SM_IDLE;
+	return 0;
+}
+
+/* One CBC block with zero input IV equals AES-ECB(Kenc, current SSC).
+ * This is the IV for the message data, not a zero data IV. */
+static inline int
+jcop4_sm_ssc_iv_ex(OSSL_LIB_CTX *libctx, const unsigned char key[16], const unsigned char ssc[16], unsigned char iv[16])
+{
+	const unsigned char zero[16] = {0};
+	return jcop4_sm_aes128_cbc_ex(libctx, 1, key, zero, ssc, 16, iv, 16);
+}
+
+static inline int
+jcop4_sm_append_tlv(unsigned char *out, size_t capacity, size_t *size,
+		unsigned char tag, const unsigned char *value, size_t length)
+{
+	size_t header = length < 128 ? 2 : length <= 255 ? 3
+							 : 4;
+	if (!out || !size || (!value && length) || length > JCOP4_SM_CRYPTO_LIMIT ||
+			*size > capacity || header > capacity - *size || length > capacity - *size - header)
+		return 1;
+	out[(*size)++] = tag;
+	if (header == 2)
+		out[(*size)++] = (unsigned char)length;
+	else {
+		out[(*size)++] = header == 3 ? 0x81 : 0x82;
+		if (header == 4)
+			out[(*size)++] = (unsigned char)(length >> 8);
+		out[(*size)++] = (unsigned char)length;
+	}
+	if (length)
+		memcpy(out + *size, value, length);
+	*size += length;
+	return 0;
+}
+
+/* Canonical, bounded, single-byte tags only; no nested/indefinite TLV. */
+static inline int
+jcop4_sm_take_tlv(const unsigned char *input, size_t size, size_t *offset,
+		unsigned char tag, const unsigned char **value, size_t *length)
+{
+	size_t pos, count;
+	unsigned int first;
+	if (!input || !offset || !value || !length || *offset > size || size - *offset < 2)
+		return 1;
+	pos = *offset;
+	if (input[pos++] != tag)
+		return 1;
+	first = input[pos++];
+	if (first < 128)
+		*length = first;
+	else {
+		count = first & 0x7F;
+		if (!count || count > 2 || count > size - pos || !input[pos])
+			return 1;
+		*length = input[pos++];
+		if (count == 2)
+			*length = (*length << 8) | input[pos++];
+		if (*length < 128 || (count == 2 && *length <= 255))
+			return 1;
+	}
+	if (*length > size - pos)
+		return 1;
+	*value = input + pos;
+	*offset = pos + *length;
+	return 0;
+}
+
+/* Emits a protected header and body, not a complete wire APDU. The caller
+ * retains responsibility for transport limits, operation authorization and
+ * ending the channel on a transport failure. No credential/data logging. */
+enum jcop4_sm_le_encoding { JCOP4_SM_LE_SHORT,
+	JCOP4_SM_LE_TWO_BYTE_256 };
+static inline int
+jcop4_sm_seal_policy_ex(OSSL_LIB_CTX *libctx, struct jcop4_sm_channel *channel, const unsigned char header[4],
+		const unsigned char *data, size_t data_size, int has_le, unsigned int le,
+		unsigned char protected_header[4], unsigned char *body, size_t capacity, size_t *written,
+		enum jcop4_sm_le_encoding encoding)
+{
+	unsigned char next[16] = {0}, iv[16] = {0}, mac[16] = {0}, local_header[4];
+	unsigned char padded[JCOP4_SM_CRYPTO_LIMIT] = {0}, encrypted[JCOP4_SM_CRYPTO_LIMIT] = {0};
+	unsigned char candidate[JCOP4_SM_CRYPTO_LIMIT] = {0}, authenticated[JCOP4_SM_CRYPTO_LIMIT] = {0};
+	size_t padded_size = 0, body_size = 0, auth_size = 32;
+	int result = 1;
+	if (!written)
+		return 1;
+	*written = 0;
+	if (!channel || channel->phase != JCOP4_SM_IDLE || !header || header[0] != 0 ||
+			(!data && data_size) || data_size > JCOP4_SM_DATA_LIMIT || !protected_header || !body ||
+			(has_le != 0 && has_le != 1) || (has_le && (!le || le > 256)) ||
+			(encoding != JCOP4_SM_LE_SHORT && encoding != JCOP4_SM_LE_TWO_BYTE_256) ||
+			(encoding == JCOP4_SM_LE_TWO_BYTE_256 && (!has_le || le != 256)))
+		goto out;
+	if (jcop4_sm_next_ssc(channel->keys.ssc, next)) {
+		jcop4_sm_invalidate(channel);
+		goto out;
+	}
+	memcpy(local_header, header, 4);
+	local_header[0] = 0x0C;
+	memcpy(authenticated, next, 16);
+	if (jcop4_sm_pad(local_header, 4, authenticated + 16, sizeof(authenticated) - 16, &padded_size))
+		goto out;
+	if (data_size) {
+		if (jcop4_sm_pad(data, data_size, padded, sizeof(padded), &padded_size) ||
+				jcop4_sm_ssc_iv_ex(libctx, channel->keys.encryption, next, iv) ||
+				jcop4_sm_aes128_cbc_ex(libctx, 1, channel->keys.encryption, iv, padded, padded_size,
+						encrypted + 1, sizeof(encrypted) - 1))
+			goto out;
+		encrypted[0] = 1;
+		if (jcop4_sm_append_tlv(candidate, sizeof(candidate), &body_size, 0x87, encrypted, padded_size + 1))
+			goto out;
+	}
+	if (has_le) {
+		unsigned char encoded[2] = {le == 256 ? 0 : (unsigned char)le, 0};
+		size_t encoded_size = 1;
+		if (encoding == JCOP4_SM_LE_TWO_BYTE_256) {
+			encoded[0] = 1;
+			encoded_size = 2;
+		}
+		if (jcop4_sm_append_tlv(candidate, sizeof(candidate), &body_size, 0x97, encoded, encoded_size))
+			goto out;
+	}
+	if (body_size) {
+		memcpy(authenticated + 32, candidate, body_size);
+		if (jcop4_sm_pad(authenticated, 32 + body_size, authenticated, sizeof(authenticated), &auth_size))
+			goto out;
+	}
+	if (jcop4_sm_cmac_ex(libctx, channel->keys.mac, authenticated, auth_size, mac) ||
+			jcop4_sm_append_tlv(candidate, sizeof(candidate), &body_size, 0x8E, mac, 8) || capacity < body_size)
+		goto out;
+	memcpy(protected_header, local_header, 4);
+	memcpy(body, candidate, body_size);
+	memcpy(channel->keys.ssc, next, 16);
+	channel->phase = JCOP4_SM_WAITING;
+	*written = body_size;
+	result = 0;
+out:
+	OPENSSL_cleanse(next, sizeof(next));
+	OPENSSL_cleanse(mac, sizeof(mac));
+	OPENSSL_cleanse(iv, sizeof(iv));
+	OPENSSL_cleanse(padded, sizeof(padded));
+	OPENSSL_cleanse(encrypted, sizeof(encrypted));
+	OPENSSL_cleanse(candidate, sizeof(candidate));
+	OPENSSL_cleanse(authenticated, sizeof(authenticated));
+	return result;
+}
+
+/* Explicit opt-ins for observed response families. No policy accepts a bare
+ * status or bypasses MAC/structure validation. The PSO policy accepts only
+ * the complete status-only16-byte error envelope, never signature data. */
+enum jcop4_sm_outer_policy { JCOP4_SM_OUTER_9000,
+	JCOP4_SM_OUTER_9000_OR_MATCHING_63CX,
+	JCOP4_SM_OUTER_PSO_STATUS_6A82 };
+
+/* Conservative response subset: optional encrypted87/01, then99/2,8E/8,
+ * physical SW9000 by default. The explicit PIN-query policy additionally
+ * permits outer63Cx only when it matches MAC-authenticated DO99 exactly.
+ * The PSO-only policy requires outer6A82, canonical99/2+8E/8 and no data.
+ * No other tags/alternatives or fallback. An authenticated
+ * inner error SW is returned as such, never converted into success. */
+static inline int
+jcop4_sm_open_report_policy_ex(OSSL_LIB_CTX *libctx, struct jcop4_sm_channel *channel, const unsigned char *response,
+		size_t size, unsigned char *plain, size_t capacity, size_t *written, unsigned int *sw,
+		enum jcop4_sm_outer_policy policy)
+{
+	unsigned char next[16] = {0}, iv[16] = {0};
+	unsigned char authenticated[JCOP4_SM_CRYPTO_LIMIT] = {0}, decrypted[JCOP4_SM_CRYPTO_LIMIT] = {0};
+	const unsigned char *ciphertext = NULL, *status = NULL, *tag = NULL;
+	size_t offset = 0, cipher_size = 0, length = 0, auth_end = 0, auth_size = 0, plain_size = 0;
+	unsigned int inner_sw = 0, outer_sw = 0;
+	int result = 1;
+	if (written)
+		*written = 0;
+	if (sw)
+		*sw = 0;
+	if (!channel || channel->phase != JCOP4_SM_WAITING || !written || !sw || !plain || !response ||
+			(policy != JCOP4_SM_OUTER_9000 && policy != JCOP4_SM_OUTER_9000_OR_MATCHING_63CX &&
+					policy != JCOP4_SM_OUTER_PSO_STATUS_6A82))
+		goto out;
+	if (size < 2 || size > JCOP4_SM_CRYPTO_LIMIT - 32)
+		goto out;
+	outer_sw = (unsigned int)response[size - 2] * 256 + response[size - 1];
+	if (policy == JCOP4_SM_OUTER_PSO_STATUS_6A82) {
+		if (outer_sw != 0x6A82 || size != 16 || response[0] != 0x99)
+			goto out;
+	} else if (outer_sw != 0x9000 && !(policy == JCOP4_SM_OUTER_9000_OR_MATCHING_63CX && (outer_sw & 0xFFF0) == 0x63C0))
+		goto out;
+	if (size < 16)
+		goto out;
+	if (jcop4_sm_next_ssc(channel->keys.ssc, next))
+		goto out;
+	if (response[0] == 0x87) {
+		if (jcop4_sm_take_tlv(response, size - 2, &offset, 0x87, &ciphertext, &length) ||
+				length < 17 || ciphertext[0] != 1 || (length - 1) % 16 ||
+				length - 1 > JCOP4_SM_DATA_LIMIT + 16)
+			goto out;
+		ciphertext++;
+		cipher_size = length - 1;
+	}
+	if (jcop4_sm_take_tlv(response, size - 2, &offset, 0x99, &status, &length) || length != 2)
+		goto out;
+	auth_end = offset;
+	if (jcop4_sm_take_tlv(response, size - 2, &offset, 0x8E, &tag, &length) || length != 8 || offset != size - 2)
+		goto out;
+	memcpy(authenticated, next, 16);
+	memcpy(authenticated + 16, response, auth_end);
+	if (jcop4_sm_pad(authenticated, 16 + auth_end, authenticated, sizeof(authenticated), &auth_size) ||
+			jcop4_sm_verify_mac8_ex(libctx, channel->keys.mac, authenticated, auth_size, tag))
+		goto out;
+	inner_sw = (unsigned int)status[0] * 256 + status[1];
+	if (outer_sw != 0x9000 && inner_sw != outer_sw)
+		goto out;
+	/* Nothing reaches the caller before MAC, padding and capacity all pass. */
+	if (cipher_size) {
+		if (jcop4_sm_ssc_iv_ex(libctx, channel->keys.encryption, next, iv) ||
+				jcop4_sm_aes128_cbc_ex(libctx, 0, channel->keys.encryption, iv, ciphertext, cipher_size, decrypted, sizeof(decrypted)))
+			goto out;
+		if (jcop4_sm_unpad(decrypted, cipher_size, &plain_size))
+			goto out;
+	}
+	if (plain_size > JCOP4_SM_DATA_LIMIT || plain_size > capacity)
+		goto out;
+	if (plain_size)
+		memcpy(plain, decrypted, plain_size);
+	*written = plain_size;
+	*sw = inner_sw;
+	memcpy(channel->keys.ssc, next, 16);
+	channel->phase = JCOP4_SM_IDLE;
+	result = 0;
+out:
+	if (result)
+		jcop4_sm_invalidate(channel);
+	OPENSSL_cleanse(next, sizeof(next));
+	OPENSSL_cleanse(authenticated, sizeof(authenticated));
+	OPENSSL_cleanse(iv, sizeof(iv));
+	OPENSSL_cleanse(decrypted, sizeof(decrypted));
+	return result;
+}
+
+#endif
diff --git a/src/libopensc/jcop4-channel-primitives.h b/src/libopensc/jcop4-channel-primitives.h
new file mode 100644
index 0000000000000000000000000000000000000000..90654391e5d7786af433fcd9ad9d874d23dac205
--- /dev/null
+++ b/src/libopensc/jcop4-channel-primitives.h
@@ -0,0 +1,152 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Offline candidate primitives. No APDU, PIN, card I/O or channel lifecycle.
+ * CBC decryption/unpadding are NOT authentication: callers must verify the
+ * MAC over the correct protected message before using recovered plaintext. */
+#ifndef JCOP4_CHANNEL_PRIMITIVES_H
+#define JCOP4_CHANNEL_PRIMITIVES_H
+
+#include <openssl/core_names.h>
+#include <openssl/crypto.h>
+#include <openssl/evp.h>
+#include <openssl/params.h>
+#include <stddef.h>
+#include <string.h>
+
+#define JCOP4_SM_CRYPTO_LIMIT 4096
+
+static inline int
+jcop4_sm_next_ssc(const unsigned char current[16], unsigned char next[16])
+{
+	unsigned char candidate[16];
+	int i, result = 1;
+	if (!current || !next)
+		return 1;
+	memcpy(candidate, current, sizeof(candidate));
+	for (i = 15; i >= 0; i--) {
+		if (++candidate[i]) {
+			memcpy(next, candidate, sizeof(candidate));
+			result = 0;
+			break;
+		}
+	}
+	/* Reject overflow without wrapping the caller's counter to zero. */
+	OPENSSL_cleanse(candidate, sizeof(candidate));
+	return result;
+}
+
+static inline int
+jcop4_sm_pad(const unsigned char *input, size_t size,
+		unsigned char *output, size_t capacity, size_t *written)
+{
+	size_t padded;
+	if (!written)
+		return 1;
+	*written = 0;
+	if ((!input && size) || !output || size >= JCOP4_SM_CRYPTO_LIMIT)
+		return 1;
+	padded = size + 16 - size % 16;
+	if (capacity < padded)
+		return 1;
+	if (size)
+		memmove(output, input, size);
+	output[size] = 0x80;
+	memset(output + size + 1, 0, padded - size - 1);
+	*written = padded;
+	return 0;
+}
+
+static inline int
+jcop4_sm_unpad(const unsigned char *input, size_t size, size_t *plain_size)
+{
+	size_t end;
+	if (!plain_size)
+		return 1;
+	*plain_size = 0;
+	if (!input || !size || size > JCOP4_SM_CRYPTO_LIMIT || size % 16)
+		return 1;
+	end = size;
+	while (end > size - 16 && input[end - 1] == 0)
+		end--;
+	if (end == size - 16 || input[end - 1] != 0x80)
+		return 1;
+	*plain_size = end - 1;
+	return 0;
+}
+
+static inline int
+jcop4_sm_aes128_cbc_ex(OSSL_LIB_CTX *libctx, int encrypt, const unsigned char key[16], const unsigned char iv[16],
+		const unsigned char *input, size_t size, unsigned char *output, size_t capacity)
+{
+	unsigned char candidate[JCOP4_SM_CRYPTO_LIMIT + 16] = {0};
+	EVP_CIPHER *cipher = NULL;
+	EVP_CIPHER_CTX *ctx = NULL;
+	int part = 0, tail = 0, result = 1;
+	if (!key || !iv || !input || !output || !size || size > JCOP4_SM_CRYPTO_LIMIT ||
+			size % 16 || capacity < size || (encrypt != 0 && encrypt != 1))
+		goto out;
+	cipher = EVP_CIPHER_fetch(libctx, "AES-128-CBC", NULL);
+	ctx = EVP_CIPHER_CTX_new();
+	if (!cipher || !ctx || EVP_CipherInit_ex2(ctx, cipher, key, iv, encrypt, NULL) != 1 ||
+			EVP_CIPHER_CTX_set_padding(ctx, 0) != 1 ||
+			EVP_CipherUpdate(ctx, candidate, &part, input, (int)size) != 1 ||
+			part < 0 || (size_t)part > size ||
+			EVP_CipherFinal_ex(ctx, candidate + part, &tail) != 1 || tail != 0 || (size_t)part != size)
+		goto out;
+	memcpy(output, candidate, size);
+	result = 0;
+out:
+	/* No partially decrypted output on error; caller buffer stays unchanged. */
+	OPENSSL_cleanse(candidate, sizeof(candidate));
+	EVP_CIPHER_CTX_free(ctx);
+	EVP_CIPHER_free(cipher);
+	return result;
+}
+
+static inline int
+jcop4_sm_cmac_ex(OSSL_LIB_CTX *libctx, const unsigned char key[16], const unsigned char *input,
+		size_t size, unsigned char output[16])
+{
+	unsigned char candidate[16] = {0};
+	EVP_MAC *algorithm = NULL;
+	EVP_MAC_CTX *ctx = NULL;
+	char cipher[] = "AES-128-CBC";
+	OSSL_PARAM params[] = {
+			OSSL_PARAM_construct_utf8_string(OSSL_MAC_PARAM_CIPHER, cipher, 0),
+			OSSL_PARAM_construct_end()};
+	size_t written = 0;
+	int result = 1;
+	if (!output)
+		return 1;
+	if (!key || (!input && size) || size > JCOP4_SM_CRYPTO_LIMIT)
+		goto out;
+	algorithm = EVP_MAC_fetch(libctx, "CMAC", NULL);
+	if (algorithm)
+		ctx = EVP_MAC_CTX_new(algorithm);
+	if (!ctx || EVP_MAC_init(ctx, key, 16, params) != 1 ||
+			(size && EVP_MAC_update(ctx, input, size) != 1) ||
+			EVP_MAC_final(ctx, candidate, &written, sizeof(candidate)) != 1 || written != 16)
+		goto out;
+	memcpy(output, candidate, sizeof(candidate));
+	result = 0;
+out:
+	if (result)
+		OPENSSL_cleanse(output, 16);
+	OPENSSL_cleanse(candidate, sizeof(candidate));
+	EVP_MAC_CTX_free(ctx);
+	EVP_MAC_free(algorithm);
+	return result;
+}
+
+static inline int
+jcop4_sm_verify_mac8_ex(OSSL_LIB_CTX *libctx, const unsigned char key[16], const unsigned char *input,
+		size_t size, const unsigned char received[8])
+{
+	unsigned char expected[16] = {0};
+	int result = 1;
+	if (received && !jcop4_sm_cmac_ex(libctx, key, input, size, expected))
+		result = CRYPTO_memcmp(expected, received, 8) != 0;
